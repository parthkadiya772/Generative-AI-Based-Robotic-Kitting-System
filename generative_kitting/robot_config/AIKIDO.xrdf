format: "xrdf"

format_version: 2.0

default_joint_positions: 
  gantry_vagn_joint: -0.0
  shoulder_pan_joint: -0.0003
  shoulder_lift_joint: -0.0
  elbow_joint: -0.0
  wrist_1_joint: 0.0001
  wrist_2_joint: -0.0002
  wrist_3_joint: -0.0001
  finger_joint: 0.0009
  left_outer_finger_joint: 0.0004
  right_outer_finger_joint: 0.0003
  left_inner_finger_joint: 0.0
  right_inner_finger_joint: 0.0
  left_inner_finger_pad_joint: 0.0
  right_inner_finger_pad_joint: 0.0

cspace: 
  joint_names: 
    - "gantry_vagn_joint"
    - "shoulder_pan_joint"
    - "shoulder_lift_joint"
    - "elbow_joint"
    - "wrist_1_joint"
    - "wrist_2_joint"
    - "wrist_3_joint"
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [10000.0, 10000.0, 10000.0, 10000.0, 10000.0, 10000.0, 10000.0]

world_collision: 
  geometry: "auto_generated_collision_sphere_group"

self_collision: 
  geometry: "auto_generated_collision_sphere_group"
  ignore: 
    gantry: 
      - "vagn"
    base_link: 
      - "shoulder_link"
    vagn: 
      - "base_link"
    shoulder_link: 
      - "upper_arm_link"
    upper_arm_link: 
      - "forearm_link"
    forearm_link: 
      - "wrist_1_link"
    wrist_1_link: 
      - "wrist_2_link"
    wrist_2_link: 
      - "wrist_3_link"
    wrist_3_link: 
      - "ee_link"
    robotiq_base_link: 
      - "left_outer_knuckle"
      - "right_outer_knuckle"
      - "left_inner_knuckle"
      - "right_inner_knuckle"
    left_outer_knuckle: 
      - "left_outer_finger"
      - "right_outer_knuckle"
      - "left_inner_knuckle"
      - "right_inner_knuckle"
    right_outer_knuckle: 
      - "right_outer_finger"
      - "left_inner_knuckle"
      - "right_inner_knuckle"
    left_outer_finger: 
      - "left_inner_finger"
    right_outer_finger: 
      - "right_inner_finger"
    right_inner_finger: 
      - "right_inner_knuckle"
    left_inner_finger: 
      - "left_inner_knuckle"
    ee_link: 
      - "robotiq_base_link"
    left_inner_knuckle: 
      - "right_inner_knuckle"

geometry: 
  auto_generated_collision_sphere_group: 
    spheres: 
      gantry_home/ur10_flattened/ur10_instanceable/shoulder_link: 
        - center: [-0.0, 0.012, 0.002]
          radius: 0.105
        - center: [0.0, 0.0, 0.0]
          radius: 0.03
      gantry_home/ur10_flattened/ur10_instanceable/upper_arm_link: 
        - center: [-0.001, -0.046, 0.46]
          radius: 0.0833
        - center: [-0.0, -0.045, 0.264]
          radius: 0.0833
        - center: [-0.0, -0.045, 0.143]
          radius: 0.0833

<?xml version="1.0" encoding="UTF-8"?>
<robot name="kitting_sys">
  
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <link name="world"/>
  
  <link name="gantry">
    <visual><geometry><box size="2.0 0.1 0.1"/></geometry><material name="grey"/></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>

  <joint name="world_gantry_joint" type="fixed">
    <parent link="world"/><child link="gantry"/><origin xyz="0. 0. 0." rpy="0. 0. 0."/>
  </joint>

  <link name="vagn">
    <visual><geometry><box size="0.2 0.2 0.1"/></geometry><material name="blue"/></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>

  <joint name="gantry_vagn_joint" type="prismatic">
    <parent link="gantry"/><child link="vagn"/><axis xyz="1. 0. 0."/> 
    <limit lower="-3.1" upper="0.0" effort="10000." velocity="1.5"/>
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
  </joint>

  <link name="base_link">
    <visual><geometry><cylinder length="0.1" radius="0.1"/></geometry></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>

  <joint name="vagn_robot_joint" type="fixed">
    <parent link="vagn"/><child link="base_link"/><origin xyz="0. 0. 0." rpy="0. 0. 0."/>
  </joint>

  <link name="shoulder_link">
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="upper_arm_link">
    <visual><origin xyz="-0.3 0 0"/><geometry><box size="0.6 0.08 0.08"/></geometry></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="forearm_link">
    <visual><origin xyz="-0.28 0 0"/><geometry><box size="0.57 0.06 0.06"/></geometry></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="wrist_1_link">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="wrist_2_link">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="wrist_3_link">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="ee_link">
    <visual><geometry><box size="0.02 0.02 0.02"/></geometry></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <origin xyz="0. 0. 0.1273" rpy="0. 0. 0."/> <parent link="base_link"/><child link="shoulder_link"/>
    <axis xyz="0. 0. 1."/><limit lower="-6.28" upper="6.28" effort="330." velocity="2.1"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <origin xyz="0. 0. 0." rpy="1.5707 0. 0. "/><parent link="shoulder_link"/><child link="upper_arm_link"/>
    <axis xyz="0. 0. 1."/><limit lower="-6.28" upper="6.28" effort="330." velocity="2.1"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <origin xyz="-0.612 0. 0. " rpy="0. 0. 0."/><parent link="upper_arm_link"/><child link="forearm_link"/>
    <axis xyz="0. 0. 1."/><limit lower="-3.14" upper="3.14" effort="150." velocity="3.14"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <origin xyz="-0.5723 0. 0.1639" rpy="0. 0. 0."/><parent link="forearm_link"/><child link="wrist_1_link"/>
    <axis xyz="0. 0. 1."/><limit lower="-6.28" upper="6.28" effort="56." velocity="3.14"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <origin xyz="0. -0.1157 0. " rpy="1.5707 0. 0. "/><parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <axis xyz="0. 0. 1."/><limit lower="-6.28" upper="6.28" effort="56." velocity="3.14"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <origin xyz="0. 0.0922 0. " rpy="-1.5707 0. 0."/><parent link="wrist_2_link"/><child link="wrist_3_link"/>
    <axis xyz="0. 0. 1."/><limit lower="-6.28" upper="6.28" effort="56." velocity="3.14"/>
  </joint>
  
  <joint name="ee_joint" type="fixed">
    <origin xyz="0. 0.082 0." rpy="1.5707 0. 0."/> 
    <parent link="wrist_3_link"/><child link="ee_link"/>
  </joint>

  <link name="robotiq_base_link">
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry></visual>
  </link>

  <joint name="FixedJoint" type="fixed">
    <parent link="ee_link"/><child link="robotiq_base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="left_outer_knuckle">
    <visual><geometry><box size="0.02 0.02 0.1"/></geometry></visual>
  </link>

  <joint name="finger_joint" type="revolute">
    <parent link="robotiq_base_link"/><child link="left_outer_knuckle"/>
    <origin xyz="-0.03 0.0 0.05" rpy="0. 0. 0."/><axis xyz="0. 1. 0."/>
    <limit lower="0.0" upper="0.7" effort="100." velocity="0.5"/>
  </joint>

  </robot>
<?xml version="1.0" encoding="UTF-8"?>
<robot name="kitting_sys">
  
  <link name="world"/>
  
  <link name="gantry">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>

  <joint name="world_gantry_joint" type="fixed">
    <parent link="world"/>
    <child link="gantry"/>
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
  </joint>

  <link name="vagn">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>

  <joint name="gantry_vagn_joint" type="prismatic">
    <parent link="gantry"/>
    <child link="vagn"/>
    <axis xyz="1. 0. 0."/> <limit lower="-3.1" upper="0.0" effort="10000." velocity="1.5"/>
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
  </joint>

  <link name="base_link">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>

  <joint name="vagn_robot_joint" type="fixed">
    <parent link="vagn"/>
    <child link="base_link"/>
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
  </joint>

  <link name="shoulder_link">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="upper_arm_link">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="forearm_link">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="wrist_1_link">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="wrist_2_link">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="wrist_3_link">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>
  <link name="ee_link">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/></inertial>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <origin xyz="0. 0. 0.1273" rpy="0. 0. -3.1415925"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-6.2831853" upper="6.2831853" effort="330." velocity="2.0943951"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <origin xyz="0. 0. 0." rpy="1.5707964 0. 0. "/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-6.2831853" upper="6.2831853" effort="330." velocity="2.0943951"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <origin xyz="-0.612 0. 0. " rpy="0. 0. 0."/>
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-3.1415927" upper="3.1415927" effort="150." velocity="3.1415927"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <origin xyz="-0.5723 0. 0.163941" rpy="0. 0. 0."/>
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-6.2831853" upper="6.2831853" effort="56." velocity="3.1415927"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <origin xyz="0. -0.1157 0. " rpy="1.5707964 0. 0. "/>
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-6.2831853" upper="6.2831853" effort="56." velocity="3.1415927"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <origin xyz="0. 0.0922 -0. " rpy="-1.5707964 -0.0000001 0.0000001"/>
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-6.2831853" upper="6.2831853" effort="56." velocity="3.1415927"/>
  </joint>
  <joint name="ee_joint" type="fixed">
    <origin xyz="-0. -0. -0." rpy="3.1415926 -1.57079638 0."/>
    <parent link="wrist_3_link"/>
    <child link="ee_link"/>
  </joint>

  <link name="robotiq_base_link"/>

  <joint name="FixedJoint" type="fixed">
    <parent link="ee_link"/>
    <child link="robotiq_base_link"/>
    <!-- Orientation from USD localRot0 = (0.5, 0.5, 0.5, 0.5) on ee_link side -->
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- Left finger chain -->
  <link name="left_outer_knuckle"/>

  <joint name="finger_joint" type="revolute">
    <!-- Primary actuated joint of the gripper (1 DOF) -->
    <parent link="robotiq_base_link"/>
    <child link="left_outer_knuckle"/>
    <origin xyz="-0.0306011 0.0 0.054904" rpy="0. 0. 0."/>
    <axis xyz="0. 1. 0."/>
    <limit lower="0.0" upper="0.6952" effort="100." velocity="0.5"/>
  </joint>

  <link name="left_outer_finger"/>

  <joint name="left_outer_finger_joint" type="fixed">
    <parent link="left_outer_knuckle"/>
    <child link="left_outer_finger"/>
    <origin xyz="0.0 0.0 0.03" rpy="0. 0. 0."/>
  </joint>

  <link name="left_inner_knuckle"/>

  <joint name="left_inner_knuckle_joint" type="revolute">
    <parent link="robotiq_base_link"/>
    <child link="left_inner_knuckle"/>
    <origin xyz="-0.0127 0.0 0.06142" rpy="0. 0. 0."/>
    <axis xyz="0. 1. 0."/>
    <limit lower="0.0" upper="0.6952" effort="100." velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="left_inner_finger"/>

  <joint name="left_inner_finger_joint" type="revolute">
    <parent link="left_inner_knuckle"/>
    <child link="left_inner_finger"/>
    <origin xyz="0.0 0.0 0.04401" rpy="0. 0. 0."/>
    <axis xyz="0. 1. 0."/>
    <limit lower="-0.6952" upper="0.0" effort="100." velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="-1.0" offset="0.0"/>
  </joint>

  <link name="left_inner_finger_pad"/>

  <joint name="left_inner_finger_pad_joint" type="fixed">
    <parent link="left_inner_finger"/>
    <child link="left_inner_finger_pad"/>
    <origin xyz="0.0 0.0 0.0" rpy="0. 0. 0."/>
  </joint>

  <!-- Right finger chain (mirrored) -->
  <link name="right_outer_knuckle"/>

  <joint name="right_outer_knuckle_joint" type="revolute">
    <parent link="robotiq_base_link"/>
    <child link="right_outer_knuckle"/>
    <origin xyz="0.0306011 0.0 0.054904" rpy="0. 3.14159265 0."/>
    <axis xyz="0. 1. 0."/>
    <limit lower="0.0" upper="0.6952" effort="100." velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="right_outer_finger"/>

  <joint name="right_outer_finger_joint" type="fixed">
    <parent link="right_outer_knuckle"/>
    <child link="right_outer_finger"/>
    <origin xyz="0.0 0.0 0.03" rpy="0. 0. 0."/>
  </joint>

  <link name="right_inner_knuckle"/>

  <joint name="right_inner_knuckle_joint" type="revolute">
    <parent link="robotiq_base_link"/>
    <child link="right_inner_knuckle"/>
    <origin xyz="0.0127 0.0 0.06142" rpy="0. 3.14159265 0."/>
    <axis xyz="0. 1. 0."/>
    <limit lower="0.0" upper="0.6952" effort="100." velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="right_inner_finger"/>

  <joint name="right_inner_finger_joint" type="revolute">
    <parent link="right_inner_knuckle"/>
    <child link="right_inner_finger"/>
    <origin xyz="0.0 0.0 0.04401" rpy="0. 0. 0."/>
    <axis xyz="0. 1. 0."/>
    <limit lower="-0.6952" upper="0.0" effort="100." velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="-1.0" offset="0.0"/>
  </joint>

  <link name="right_inner_finger_pad"/>

  <joint name="right_inner_finger_pad_joint" type="fixed">
    <parent link="right_inner_finger"/>
    <child link="right_inner_finger_pad"/>
    <origin xyz="0.0 0.0 0.0" rpy="0. 0. 0."/>
  </joint>

</robot>
# ============================================================
# Generative Kitting System — Environment Template
# Copy to .env and fill in values for your machine:
#   cp .env.example .env
# .env is gitignored and never committed.
# ============================================================

# Active Ollama endpoint used for all inference by default.
# localhost:11434 if you run `ollama serve` locally.
OLLAMA_BASE_URL=http://localhost:11434


# Optional remote zero-shot detector (OWL-V2 / Grounding DINO).
# Leave blank to run the detector in-process on this machine.
DETECTOR_BASE_URL=

# Isaac Sim bridge — loopback only by default.
# Change to 0.0.0.0 only if you need LAN clients (no auth on the bridge).
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8600

# Path to your Isaac Sim install directory (the one containing exts/).
#   Linux:   /home/<user>/.local/share/ov/pkg/isaac-sim-<ver>
#   Windows: %LOCALAPPDATA%\ov\pkg\isaac-sim-<ver>
ISAACSIM_PATH=

# Project root — set this before launching Isaac Sim so the bridge
# launcher (kitting_bridge_server.py) can find the source tree.
#   export KITTING_PROJECT_ROOT=/path/to/robot_in_air   (add to ~/.bashrc)
KITTING_PROJECT_ROOT=

# OpenAI API key — only needed for the cloud VLM/LLM provider.
# Leave blank when using Ollama.
OPENAI_API_KEY=

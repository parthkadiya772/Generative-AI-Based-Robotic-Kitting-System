# ============================================================
# Generative Kitting System — Environment Variables (template)
# ============================================================
# Copy this file to `.env` and fill in the values for YOUR machine.
# .env is gitignored, so anything you put in it stays local — feel
# free to write internal IPs, API keys, and machine-specific paths
# directly into your .env. Anything you leave blank falls back to
# the default in config.yaml (usually localhost).
# ============================================================

# --- Model server endpoint ---------------------------------
# WHERE Ollama serves your VLM / LLM. Two common shapes:
#
#   1) Local — you ran `ollama serve` on your own machine and
#      pulled the models locally:
#          OLLAMA_BASE_URL=http://localhost:11434
#
#   2) Remote — your lab runs a shared GPU box (often behind a
#      VPN) that already has the models loaded; nothing to pull
#      on your machine:
#          OLLAMA_BASE_URL=http://<lab-gpu-host>:11434
#
# Pick one and uncomment / edit it. If you leave this blank the
# code falls back to http://localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434

# Optional zero-shot detector server (OWL-V2 / Grounding DINO).
# Leave blank to run the detector in-process. Set a URL to call a
# remote detector instead:
#     DETECTOR_BASE_URL=http://<gpu-host>:8700
DETECTOR_BASE_URL=

# --- Isaac Sim bridge --------------------------------------
# Host the bridge HTTP server binds to. Loopback by default — the
# bridge has no authentication, so change to 0.0.0.0 ONLY if you
# knowingly want LAN clients to call /api/execute, /api/pick, etc.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8600

# --- Isaac Sim install path --------------------------------
# Root of your Isaac Sim install (the directory containing the
# `exts/` folder). Only the archived archive/src_ur10_legacy/robot_control.py uses it;
# the bridge runs inside Isaac Sim and does not. Default locations:
#   Windows : %LOCALAPPDATA%\ov\pkg\isaac-sim-<ver>
#   Linux   : ~/.local/share/ov/pkg/isaac-sim-<ver>
ISAACSIM_PATH=

# --- API keys (only for OpenAI / cloud VLM providers) ------
# Leave blank when using local Ollama models.
OPENAI_API_KEY=

# --- Isaac Sim bridge launcher (optional) ------------------
# Not needed: kitting_bridge_server.py finds the repo from the open
# USD stage, the current directory or $HOME. Set it only to force a
# different checkout (or in the exec'ing namespace:
#   KITTING_PROJECT_ROOT = "/path/to/robot_in_air").
# KITTING_PROJECT_ROOT=

# --- Robot selection ---------------------------------------
# Folder holding robot.yaml + cuMotion URDF/XRDF.
ROBOT_CONFIG_PATH=${PROJECT_ROOT}/generative_kitting/robot_config/ur10e

# --- Project root (auto-detected, no need to set) ----------
# The config loader derives this from the source tree; you only
# need to set it if you copy config.yaml outside the repo.
# PROJECT_ROOT=
